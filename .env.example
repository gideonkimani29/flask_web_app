# ──────────────────────────────────────────────────
# M-Pesa Daraja API Credentials
# ──────────────────────────────────────────────────
MPESA_ENVIRONMENT=sandbox          # sandbox | production
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# Lipa Na M-Pesa (STK Push)
MPESA_SHORTCODE=174379             # Your business shortcode
MPESA_LIPA_NA_MPESA_SHORTCODE=174379
MPESA_LIPA_NA_MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# B2C Settings
MPESA_B2C_SHORTCODE=600986
MPESA_B2C_INITIATOR_NAME=testapi
MPESA_B2C_SECURITY_CREDENTIAL=your_security_credential_here

# Callback URLs (must be publicly accessible HTTPS URLs)
MPESA_STK_CALLBACK_URL=https://yourdomain.com/api/v1/stk/callback
MPESA_C2B_VALIDATION_URL=https://yourdomain.com/api/v1/c2b/validate
MPESA_C2B_CONFIRMATION_URL=https://yourdomain.com/api/v1/c2b/confirm
MPESA_B2C_RESULT_URL=https://yourdomain.com/api/v1/b2c/result
MPESA_B2C_TIMEOUT_URL=https://yourdomain.com/api/v1/b2c/timeout
MPESA_BALANCE_RESULT_URL=https://yourdomain.com/api/v1/query/balance-result
MPESA_BALANCE_TIMEOUT_URL=https://yourdomain.com/api/v1/query/balance-timeout
MPESA_STATUS_RESULT_URL=https://yourdomain.com/api/v1/query/status-result
MPESA_STATUS_TIMEOUT_URL=https://yourdomain.com/api/v1/query/status-timeout

# ──────────────────────────────────────────────────
# Application Settings
# ──────────────────────────────────────────────────
APP_NAME=MPesa Daraja Service
APP_VERSION=1.0.0
DEBUG=false
API_KEY=your-super-secret-api-key-change-in-production

# ──────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./mpesa.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mpesa_db

# ──────────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json   # json | console
